rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'hmohsen282@gmail.com' ||
        request.auth.token.email == '7snmo7sen1998@gmail.com'
      );
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email;
    }

    // حقول الاشتراك — المالك ما يقدرش يعدّلها (الأدمن بس)
    function subFields() {
      return ['subUntil', 'blocked', 'trialEnds', 'measUnlockUntil', 'actNote'];
    }
    // صورة البروفايل — حد أقصى 300 KB (الصورة الطبيعية 256px ~ 40 KB)
    function photoOk() {
      return !('photo' in request.resource.data) || request.resource.data.photo.size() < 300000;
    }

    // حسابات المشتركين — المالك يقرأ حسابه ويعدّل بياناته العادية، الأدمن كل حاجة
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      // إنشاء أول مرة (التجربة 7 أيام) — بدون اشتراك جاهز أو تجربة طويلة
      allow create: if isAdmin() || (isOwner(uid) && photoOk()
        && (!('subUntil' in request.resource.data) || request.resource.data.subUntil == 0)
        && (!('blocked' in request.resource.data) || request.resource.data.blocked == false)
        && (!('trialEnds' in request.resource.data) || request.resource.data.trialEnds <= request.time.toMillis() + 8 * 86400000)
        && (!('measUnlockUntil' in request.resource.data) || request.resource.data.measUnlockUntil <= request.time.toMillis() + 73 * 3600000));
      allow update: if isAdmin() || (isOwner(uid) && photoOk()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(subFields()));
      allow list, delete: if isAdmin();
      // نسخة بيانات التمرين الخاصة بكل مستخدم
      match /data/{doc} {
        allow read, create, update, delete: if isOwner(uid) || isAdmin();
      }
    }

    // الأكواد — أي مسجل يقرأ كود، ويزوّد عداد الاستخدام +1 بس، والأدمن يدير
    match /coupons/{code} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == resource.data.used + 1);
    }

    // رسالة الكابتن الجماعية — قراءة للمسجلين، كتابة للأدمن
    match /annc/{doc} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // قراءات الرسائل — المسجل يسجل قراءته بس باسمه
    match /anncReads/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get: if signedIn();
      allow list, update, delete: if isAdmin();
    }

    // المسوقين (أفلييت) — الأدمن يدير، والمسجل يقرأ
    match /affils/{code} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // سجل العمولات — المسجل يسجل عملية باسم إيميله هو بس، والكود لازم يكون موجود
    match /refs/{id} {
      allow create: if signedIn()
        && request.resource.data.email == myEmail()
        && exists(/databases/$(database)/documents/coupons/$(request.resource.data.code));
      allow get, list, update, delete: if isAdmin();
    }

    // آراء المشتركين — القراءة للمسجلين، والنشر/الإخفاء/المسح للأدمن بس
    match /reviews/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // طلبات دفع PayPal — المسجل يسجل طلبه باسم إيميله بحالة "pending" بس، والأدمن يقرأ ويفعّل
    match /payreq/{id} {
      allow create: if signedIn()
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'pending';
      allow get, list, update: if isAdmin();
      allow delete: if false;
    }
  }
}
